{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "resources", "storage", "service", "probes"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always"]}
      },
      "additionalProperties": false
    },
    "replicaCount": {"type": "integer", "const": 1},
    "service": {"type": "object", "required": ["port"], "properties": {"port": {"type": "integer", "const": 8188}}, "additionalProperties": false},
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resources"},
        "limits": {"$ref": "#/definitions/resources"}
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["create", "existingClaim", "size", "storageClassName", "accessMode", "mountPath"],
      "properties": {
        "create": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$"},
        "storageClassName": {"type": "string"},
        "accessMode": {"const": "ReadWriteOnce"},
        "mountPath": {"const": "/data"}
      },
      "additionalProperties": false
    },
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "probes": {
      "type": "object",
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": {"$ref": "#/definitions/probe"},
        "readiness": {"$ref": "#/definitions/probe"},
        "liveness": {"$ref": "#/definitions/probe"}
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["cpu", "memory", "nvidia.com/gpu"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"},
        "nvidia.com/gpu": {"type": "integer", "const": 1}
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": ["path", "periodSeconds", "failureThreshold"],
      "properties": {
        "path": {"const": "/"},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "auth", "network", "storage", "service", "networkPolicy", "resources"],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^google-channel-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"const": "Always"}
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "auth": {
      "type": "object",
      "required": ["existingSecretName"],
      "properties": {
        "existingSecretName": {"type": "string", "minLength": 1}
      }
    },
    "network": {
      "type": "object",
      "required": ["url", "existingSecretName", "tokenKey"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "proxyUrl": {"type": "string"},
        "existingSecretName": {"type": "string", "minLength": 1},
        "tokenKey": {"type": "string", "minLength": 1}
      }
    },
    "storage": {
      "type": "object",
      "required": ["create", "existingClaim", "storageClassName", "size", "mountPath", "stateDbPath"],
      "properties": {
        "create": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClassName": {"type": "string"},
        "volumeName": {"type": "string"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$"},
        "mountPath": {"type": "string", "minLength": 1},
        "stateDbPath": {"type": "string", "minLength": 1}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "storageClassName": {"type": "string"},
        "volumeName": {"type": "string"},
        "size": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "required": ["managementPort", "executionPort"],
      "properties": {
        "managementPort": {"const": 8000},
        "executionPort": {"const": 8001}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "stationNamespace", "studioPodName", "runtimePodName", "etcdPodName", "networkPodName", "imageNamespace", "imagePodName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "stationNamespace": {"type": "string", "minLength": 1},
        "studioPodName": {"type": "string", "minLength": 1},
        "runtimePodName": {"type": "string", "minLength": 1},
        "etcdPodName": {"type": "string", "minLength": 1},
        "networkNamespace": {"type": "string", "minLength": 1},
        "networkPodName": {"type": "string", "minLength": 1},
        "imageNamespace": {"type": "string", "minLength": 1},
        "imagePodName": {"type": "string", "minLength": 1},
        "openclashNamespace": {"type": "string"},
        "openclashAppLabel": {"type": "string"},
        "openclashPorts": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    }
  }
}


{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "instance", "auth", "contentOrigin", "turn", "storage", "resources", "service", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"const": "blender-v0.1.12"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"const": "Always"}
      }
    },
    "replicaCount": {"const": 1},
    "instance": {
      "type": "object",
      "required": ["configMapName", "configKey"],
      "properties": {
        "configMapName": {"type": "string"},
        "configKey": {"const": "instances.json"}
      }
    },
    "auth": {
      "type": "object",
      "required": ["existingSecretName", "studioTokenKey", "workerTokenKey", "guiPasswordKey", "contentSecretName", "contentTokenKey", "turnSecretName", "turnSecretKey"],
      "properties": {
        "existingSecretName": {"type": "string"},
        "studioTokenKey": {"const": "BLENDER_STUDIO_TOKEN"},
        "workerTokenKey": {"const": "BLENDER_WORKER_A"},
        "guiPasswordKey": {"const": "BLENDER_GUI_A_PASSWORD"},
        "contentSecretName": {"type": "string"},
        "contentTokenKey": {"const": "token"},
        "turnSecretName": {"type": "string"},
        "turnSecretKey": {"const": "auth.conf"}
      }
    },
    "contentOrigin": {"type": "string"},
    "turn": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "storage": {
      "type": "object",
      "required": ["create", "existingClaim", "storageClassName", "size"],
      "properties": {
        "create": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClassName": {"type": "string"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$"}
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object"},
        "limits": {"type": "object"}
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {"port": {"const": 8080}}
    },
    "networkPolicy": {
      "type": "object",
      "required": ["stationNamespace", "studioPodName"],
      "properties": {
        "stationNamespace": {"type": "string", "minLength": 1},
        "studioPodName": {"type": "string", "minLength": 1}
      }
    }
  }
}

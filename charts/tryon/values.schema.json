{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["appId", "appVersion", "replicas", "image", "credentials", "storage", "studio"],
  "properties": {
    "appId": {"const": "tryon"},
    "appVersion": {"const": "0.1.2"},
    "replicas": {"type": "integer", "const": 1},
    "workloadName": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$", "maxLength": 50},
    "image": {
      "type": "object", "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9./:_-]+$"},
        "tag": {"const": "tryon-v0.1.2"},
        "pullPolicy": {"const": "Always"}
      }
    },
    "credentials": {
      "type": "object", "required": ["existingSecret", "serviceTokenKey", "studioUrlKey", "callersKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "serviceTokenKey": {"type": "string", "minLength": 1},
        "studioUrlKey": {"type": "string", "minLength": 1},
        "callersKey": {"type": "string", "minLength": 1}
      }
    },
    "storage": {
      "type": "object", "required": ["create", "existingClaim", "size"],
      "properties": {
        "create": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}
      }
    },
    "studio": {
      "type": "object", "required": ["namespace", "podLabels"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "podLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    }
  }
}

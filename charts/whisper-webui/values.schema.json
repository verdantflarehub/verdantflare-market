{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "replicaCount",
    "service",
    "resources",
    "storage",
    "review",
    "probes"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "const": "Always"
        }
      },
      "additionalProperties": false
    },
    "replicaCount": {
      "const": 1
    },
    "service": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "const": 7860
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "nvidia.com/gpu"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            },
            "nvidia.com/gpu": {
              "const": 1
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "nvidia.com/gpu"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            },
            "nvidia.com/gpu": {
              "const": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": [
        "create",
        "existingClaim",
        "size",
        "storageClassName",
        "accessMode",
        "mountPath"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Gi|Ti)$"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessMode": {
          "const": "ReadWriteOnce"
        },
        "mountPath": {
          "const": "/Whisper-WebUI/models"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "modelAssetsApproved",
        "accessApproved",
        "licenseApproved",
        "existingSecretName"
      ],
      "properties": {
        "modelAssetsApproved": {
          "type": "boolean"
        },
        "accessApproved": {
          "type": "boolean"
        },
        "licenseApproved": {
          "type": "boolean"
        },
        "existingSecretName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "probes": {
      "type": "object",
      "required": [
        "startup",
        "readiness",
        "liveness"
      ],
      "properties": {
        "startup": {
          "type": "object",
          "required": [
            "path",
            "periodSeconds",
            "failureThreshold"
          ],
          "properties": {
            "path": {
              "const": "/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "required": [
            "path",
            "periodSeconds",
            "failureThreshold"
          ],
          "properties": {
            "path": {
              "const": "/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "required": [
            "path",
            "periodSeconds",
            "failureThreshold"
          ],
          "properties": {
            "path": {
              "const": "/"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
